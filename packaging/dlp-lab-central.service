[Unit]
Description=DLP Lab central event server
After=network.target
ConditionPathExists=/etc/dlp-lab/central-server.json

[Service]
Type=exec
User=dlp-central
Group=dlp-central
StateDirectory=dlp-central
StateDirectoryMode=0700
ExecStart=/usr/libexec/dlp-lab/central-service server
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0

[Install]
WantedBy=multi-user.target
