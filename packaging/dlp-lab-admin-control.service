[Unit]
Description=DLP fixed administrative restart broker
After=dbus.service

[Service]
Type=exec
User=root
Group=dlp-forwarder
ExecStart=/usr/libexec/dlp-lab/admin-control
RuntimeDirectory=dlp-admin-control
RuntimeDirectoryMode=0750
StateDirectory=dlp-admin-control
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LimitCORE=0

[Install]
WantedBy=multi-user.target
