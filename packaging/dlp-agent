#!/usr/bin/python3 -I
"""Packaged entry point: no cwd, user site, or caller PYTHONPATH imports."""
import os
import sys
if os.geteuid() != 0:
    print('Управление DLP доступно только администратору.', file=sys.stderr)
    raise SystemExit(2)
os.environ['PYTHONPATH'] = '/usr/lib/dlp-lab/src'
os.environ['PYTHONNOUSERSITE'] = '1'
os.environ['PYTHONSAFEPATH'] = '1'
os.environ['DLP_INSTALL_MODE'] = 'system'
sys.path.insert(0, '/usr/lib/dlp-lab/src')
from dlp.cli import main
if '--policy' not in sys.argv[1:] and sys.argv[1:2] != ['central']:
    sys.argv[1:1] = ['--policy', '/etc/dlp-lab/system/policy.yaml']
raise SystemExit(main())
