#!/bin/sh
set -e
case "$1" in
    remove|deconfigure|upgrade)
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop dlp-lab-files.service dlp-lab-session.service >/dev/null || true
        fi
        if [ "$1" != upgrade ] && [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop dlp-lab-central.service dlp-lab-forwarder.service dlp-lab-session.service >/dev/null || true
        fi
        # Remove only bytecode belonging to this package before dpkg drops its list.
        if command -v py3clean >/dev/null 2>&1; then
            py3clean -p dlp-lab
        fi
        ;;
esac
